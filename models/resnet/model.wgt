wgt 0.5
model TinyResNet
input x: f32[64]
output y: f32[3]
parameter stem_weight: f32[2,1,3,3]
parameter stem_bias: f32[2]
parameter block1_weight: f32[2,2,3,3]
parameter block1_bias: f32[2]
parameter block2_weight: f32[2,2,3,3]
parameter block2_bias: f32[2]
parameter head_weight: f32[3,32]
parameter head_bias: f32[3]
fn forward(x) {
    let h = relu(conv(x as [1,8,8], stem_weight as [2,1,3,3], stem_bias, [2,2], [1,1], [1,1], 1));
    let residual = relu(conv(h, block1_weight as [2,2,3,3], block1_bias, [1,1], [1,1], [1,1], 1));
    let branch = conv(residual, block2_weight as [2,2,3,3], block2_bias, [1,1], [1,1], [1,1], 1);
    return linear(relu(h + branch) as [32], head_weight, head_bias);
}
